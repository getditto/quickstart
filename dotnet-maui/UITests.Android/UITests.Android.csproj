<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Using direct BrowserStack REST API approach like other apps in this repo -->

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="NUnit" Version="4.6.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Appium.WebDriver" Version="5.2.0" />
  </ItemGroup>

  <!-- Force copy Appium.Net.dll to test output directory for VSTest -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)appium.webdriver/5.2.0/lib/net6.0/Appium.Net.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Appium.Net.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UITests.Shared/UITests.Shared.csproj" />
  </ItemGroup>

</Project>
