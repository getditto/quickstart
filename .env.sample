#!/usr/bin/env bash

# Copy this file from ".env.sample" to ".env", then fill in these values
# A Ditto Database ID and development token can be obtained from https://portal.ditto.live
# DITTO_DATABASE_ID is required in both online and offline mode. For offline-only
# mode it can be any valid UUID, as long as every peer uses the same one.
DITTO_DATABASE_ID=""
DITTO_DEVELOPMENT_TOKEN=""
DITTO_SERVER_URL=""
# When non-empty, this selects offline mode and DITTO_DEVELOPMENT_TOKEN and
# DITTO_SERVER_URL are not required. DITTO_DATABASE_ID is still required.
DITTO_OFFLINE_LICENSE_TOKEN=""
