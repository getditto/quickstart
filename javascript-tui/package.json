{
	"name": "javascript",
	"version": "0.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "npm run build && node dist/cli.js",
		"build": "babel --out-dir=dist source",
		"dev": "babel --out-dir=dist --watch source",
		"test": "npm run test:format && npm run test:integration",
		"test:format": "prettier --check .",
		"test:integration": "npm run build && DITTO_CLOUD_TASK_TITLE=\"<insert-my-task-name-here>\" node tests/integration_test.js",
		"format": "prettier --write ."
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@dittolive/ditto": "5.0.1",
		"dotenv": "^16.6.1",
		"ink": "^4.4.1",
		"meow": "^11.0.0",
		"react": "^18.3.1",
		"tempy": "^3.2.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"@vdemedes/prettier-config": "^2.0.1",
		"eslint": "^9.39.4",
		"eslint-config-xo-react": "^0.30.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"ink-testing-library": "^4.0.0",
		"prettier": "^2.8.8"
	},
	"overrides": {
		"tar": "7.5.11",
		"undici": "6.24.1",
		"flatted": "3.4.2",
		"lodash": "4.18.1",
		"glob": "^13.0.6"
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"babel": {
		"presets": [
			[
				"@babel/preset-env",
				{
					"modules": false
				}
			],
			"@babel/preset-react"
		]
	}
}
